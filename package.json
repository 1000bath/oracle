{
  "name": "mantic",
  "version": "0.2.0",
  "description": "Persona framework — encode identity as searchable knowledge for AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp-server.js",
    "./cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mantic": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1000bath/mantic.git"
  },
  "homepage": "https://github.com/1000bath/mantic#readme",
  "bugs": {
    "url": "https://github.com/1000bath/mantic/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
